[worldserver]

########################################
# mod-nat-pagle
#
# Nat Pagle's fishing dailies, The Anglers reputation and the Stranglethorn fishing contest. The
# quests, the reputation and the wares are world SQL; this file sets the coins paid and the shop's
# rank list.
########################################

#
#    NatPagle.Coins
#        Description: Coins added to the account wallet of mod-boss-coins for each daily handed
#                     in. 0 pays none. Without mod-boss-coins this does nothing.
#        Default:     1
#

NatPagle.Coins = 1

#
#    NatPagle.ShopUnlocks
#        Description: When Nat's shop opens, list in chat the player's Anglers rank and the wares
#                     each higher rank adds. Wares that also wait on something else, such as a
#                     progression tier, are left out. 0 lists nothing.
#        Default:     1
#

NatPagle.ShopUnlocks = 1

#
#    NatPagle.Derby.FirstPlaceCoins
#        Description: Extravagant Extravaganza Coins for the contest's first winner each week, on
#                     top of what every winner gets. 0 pays none.
#        Default:     2
#

NatPagle.Derby.FirstPlaceCoins = 2

#
#    NatPagle.Derby.RunnerUpCoins
#        Description: The same bonus for the second and third winners. 0 pays none.
#        Default:     1
#

NatPagle.Derby.RunnerUpCoins = 1
